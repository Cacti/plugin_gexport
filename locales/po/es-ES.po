#: setup.php:704
msgid "Sanitize remote directory"
msgstr "Desinfectar el directorio remoto"

#: setup.php:705
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Seleccione esta opción si desea eliminar cualquier archivo existente en el directorio remoto FTP. Esta opción sólo se utiliza cuando se utilizan las funciones ftp incorporadas de PHP."

#: setup.php:710
msgid "Remote Host"
msgstr "Nombre del servidor remoto:"

#: setup.php:711
msgid "Denotes the host to send Exported Graphs to."
msgstr "Indica el host al que se enviarán los gráficos exportados."

#: setup.php:718
msgid "Remote Port"
msgstr "Puerto Remoto"

#: setup.php:719
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Puerto de comunicación a utilizar para el método de exportación si no es estándar (dejar vacío para los valores predeterminados)."

#: setup.php:727
msgid "Use passive mode"
msgstr "Usar el modo pasivo"

#: setup.php:728
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Compruebe esto si desea conectarse en modo pasivo al servidor FTP."

#: setup.php:733
msgid "User"
msgstr "Usuario"

#: setup.php:734
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Cuenta para iniciar sesión en el servidor remoto (dejarla vacía para los valores predeterminados)."

#: setup.php:741
msgid "Password"
msgstr "Contraseña"

#: setup.php:742
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Contraseña para la cuenta ftp remota (dejar en blanco)."

#: setup.php:749
msgid "Private Key Path"
msgstr "Ruta de la clave privada"

#: setup.php:750
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Para SCP y RSYNC, introduzca la ruta de clave privada si es necesario."

