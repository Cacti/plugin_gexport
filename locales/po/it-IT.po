msgid "Export Directory"
msgstr "Elenco delle esportazioni"

#: setup.php:669
msgid "This is the directory, either on the local system or on the remote system, that will contain the exported data."
msgstr "Questa è la directory, sia sul sistema locale o sul sistema remoto, che conterrà i dati esportati."

#: setup.php:675
msgid "Local Scratch Directory"
msgstr "Elenco locale dei gratta e vinci"

#: setup.php:676
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "Questa è la directory che Cacti memorizzerà temporaneamente l'output prima di inviarlo al sito remoto tramite il metodo di trasferimento.  Il contenuto di questa directory verrà cancellato dopo il trasferimento dei dati."

#: setup.php:683
msgid "Remote Options"
msgstr "Opzioni remote"

#: setup.php:688
msgid "Sanitize remote directory"
msgstr "Disinfezione della directory remota"

#: setup.php:689
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Selezionare questa opzione se si desidera eliminare i file esistenti nella directory remota FTP. Questa opzione è in uso solo quando si utilizzano le funzioni ftp integrate in PHP."

#: setup.php:694
msgid "Remote Host"
msgstr "Host remoto"

#: setup.php:695
msgid "Denotes the host to send Exported Graphs to."
msgstr "Indica l'host a cui inviare i grafici esportati."

#: setup.php:702
msgid "Remote Port"
msgstr "Porta remota"

#: setup.php:703
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Porta di comunicazione da utilizzare per il metodo di esportazione se non standard (lasciare vuota per le impostazioni predefinite)."

#: setup.php:711
msgid "Use passive mode"
msgstr "Utilizzare la modalità passiva"

#: setup.php:712
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Selezionare questa opzione se si desidera connettersi in modalità passiva al server FTP."

#: setup.php:717
msgid "User"
msgstr "Utente"

#: setup.php:718
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Account per accedere al server remoto (lasciare vuoto per le impostazioni predefinite)."

#: setup.php:725
msgid "Password"
msgstr "Password"

#: setup.php:726
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Password per l'account ftp remoto (lasciare vuoto per vuoto)."

#: setup.php:733
msgid "Private Key Path"
msgstr "Percorso Chiave Privata"

#: setup.php:734
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Per SCP e RSYNC, immettere, se necessario, il percorso della chiave privata."

#: setup.php:757
msgid "Exported Cacti Graph Pages"
msgstr "Pagine del grafico Cactus esportate"

#: setup.php:763
msgid "(Edit)"
msgstr "(Modifica)"

#: setup.php:769
msgid "Actions"
msgstr "Azioni"
