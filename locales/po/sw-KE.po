msgstr "Safisha saraka ya mbali"

#: setup.php
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Tiki hii ikiwa unataka kufuta faili zozote zilizopo kwenye saraka ya mbali ya FTP. Chaguo hili linatumika tu unapotumia vitendakazi vya ftp vilivyojengwa ndani ya PHP."

#: setup.php
msgid "Remote Host"
msgstr "Kipangishi cha Mbali"

#: setup.php
msgid "Denotes the host to send Exported Graphs to."
msgstr "Inabainisha kipangishi ambako Grafu Zilizohamishwa zitatumwa."

#: setup.php
msgid "Remote Port"
msgstr "Mlango wa Mbali"

#: setup.php
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Mlango wa mawasiliano wa kutumia kwa mbinu ya uhamishaji ikiwa si wa kawaida (acha wazi kwa chaguo-msingi)."

#: setup.php
msgid "Use passive mode"
msgstr "Tumia hali tulivu"

#: setup.php
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Tiki hii ikiwa unataka kuunganisha katika hali tulivu kwenye seva ya FTP."

#: setup.php
msgid "User"
msgstr "Mtumiaji"

#: setup.php
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Akaunti ya kuingia kwenye seva ya mbali (acha wazi kwa chaguo-msingi)."

#: setup.php
msgid "Password"
msgstr "Nenosiri"

#: setup.php
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Nenosiri la akaunti ya ftp ya mbali (acha wazi ikiwa ni tupu)."

#: setup.php
msgid "Private Key Path"
msgstr "Njia ya Ufunguo wa Faragha"

#: setup.php
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Kwa SCP na RSYNC, weka njia ya Ufunguo wa Faragha ikiwa inahitajika."

#: setup.php
msgid "Exported Cacti Graph Pages"
msgstr "Kurasa za Grafu za Cacti Zilizohamishwa"

#: setup.php
msgid "(Edit)"
msgstr "(Hariri)"

#: setup.php
msgid "Actions"
msgstr "Vitendo"

