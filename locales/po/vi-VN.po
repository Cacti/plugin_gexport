#: setup.php:550
msgid "The user name to utilize for establishing permissions to Cacti Graphs.  This user name will be used to determine which Graphs/Trees can be exported.  N/A means don't assume any security is in place."
msgstr "Tên người dùng để sử dụng để thiết lập quyền đối với Đồ thị Cacti. Tên người dùng này sẽ được sử dụng để xác định Đồ thị / Cây nào có thể được xuất. Không có nghĩa là không cho rằng có bất kỳ bảo mật nào được đưa ra."

#: setup.php:559
msgid "The Tree(s) to export."
msgstr "Cây cần xuất."

#: setup.php:566
msgid "Expand Devices/Sites"
msgstr "Mở rộng thiết bị / trang web"

#: setup.php:567
msgid "This setting determines if Tree Devices and Site Templates and Devices will be expanded or not.  If set to expanded, each host will have a sub-folder containing either Graph Templates or Data Query items."
msgstr "Cài đặt này xác định xem Thiết bị cây và Mẫu trang web và Thiết bị sẽ được mở rộng hay không. Nếu được đặt thành mở rộng, mỗi máy chủ sẽ có một thư mục con chứa các mục Biểu đồ dữ liệu hoặc Truy vấn dữ liệu."

#: setup.php:572
msgid "Off"
msgstr "Tắt"

#: setup.php:573
msgid "On"
msgstr "Bật"

#: setup.php:578
msgid "The Site for Cacti Graphs to be Exported from."
msgstr "Trang web cho đồ thị Cacti sẽ được xuất từ."

#: setup.php:585
msgid "Graph Thumbnail Width"
msgstr "Đồ thị chiều rộng hình thu nhỏ"

#: setup.php:586
msgid "The default width of Thumbnail Graphs in pixels."
msgstr "Độ rộng mặc định của Đồ thị hình thu nhỏ tính bằng pixel."

#: setup.php:594
msgid "Graph Thumbnail Height"
msgstr "Đồ thị chiều cao hình thu nhỏ"

#: setup.php:595
msgid "The height of Thumbnail Graphs in pixels."
msgstr "Chiều cao của đồ thị hình thu nhỏ tính bằng pixel."

#: setup.php:603
msgid "Default View Thumbnails"
msgstr "Xem hình thu nhỏ mặc định"

#: setup.php:604
msgid "Check this if you want the default Graph View to be in Thumbnail mode."
msgstr "Kiểm tra điều này nếu bạn muốn Chế độ xem biểu đồ mặc định ở chế độ hình thu nhỏ."

#: setup.php:609
msgid "Default Graph Columns"
msgstr "Cột đồ thị mặc định"

#: setup.php:610
msgid "The number of columns to use by default when displaying Graphs."
msgstr "Số lượng cột được sử dụng theo mặc định khi hiển thị Biểu đồ."

#: setup.php:618
msgid "Graphs Per Page"
msgstr "Đồ thị trên mỗi trang"

#: setup.php:619
msgid "Choose the number of Graphs Per Page to display."
msgstr "Chọn số lượng đồ thị trên mỗi trang để hiển thị."

#: setup.php:626
msgid "Maximum Graphs to Export"
msgstr "Đồ thị tối đa để xuất"

#: setup.php:627
msgid "After this number is reached, an error will be generated, but exporting will continue.  Set to 0 for no limit."
msgstr "Sau khi đạt được số này, một lỗi sẽ được tạo ra, nhưng việc xuất sẽ tiếp tục. Đặt thành 0 không giới hạn."

#: setup.php:635
msgid "Export Location Information"
msgstr "Xuất thông tin vị trí"

#: setup.php:640
msgid "Export Thumbnails"
msgstr "Thời gian xuất"

#: setup.php:641
msgid "Check this if you want the export thumbnails mode."
msgstr "Kiểm tra điều này nếu bạn muốn Chế độ xem biểu đồ mặc định ở chế độ hình thu nhỏ."

#: setup.php:646
msgid "Clear Directory"
msgstr "Xuất thư mục"

#: setup.php:647
msgid "Check this Checkbox if you wish this Graph Export to clear the final directory before populating."
msgstr "Kiểm tra Hộp kiểm này nếu bạn muốn Định nghĩa xuất biểu đồ này được bật."

#: setup.php:652
msgid "Export Directory"
msgstr "Xuất thư mục"

#: setup.php:653
msgid "This is the directory, either on the local system or on the remote system, that will contain the exported data."
msgstr "Đây là thư mục, trên hệ thống cục bộ hoặc trên hệ thống từ xa, sẽ chứa dữ liệu được xuất."

#: setup.php:659
msgid "Local Scratch Directory"
msgstr "Thư mục cào cục bộ"

#: setup.php:660
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "Đây là thư mục mà Cacti sẽ tạm thời lưu trữ đầu ra trước khi gửi đến trang web từ xa thông qua phương thức chuyển. Nội dung của thư mục này sẽ bị xóa sau khi dữ liệu được truyền."

#: setup.php:667
msgid "Remote Options"
msgstr "Tùy chọn từ xa"

#: setup.php:672
msgid "Sanitize remote directory"
msgstr "Vệ sinh thư mục từ xa"

#: setup.php:673
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Kiểm tra điều này nếu bạn muốn xóa bất kỳ tệp hiện có trong thư mục từ xa FTP. Tùy chọn này chỉ được sử dụng khi sử dụng các hàm ftp tích hợp sẵn của PHP."

#: setup.php:678
msgid "Remote Host"
msgstr "Máy chủ từ xa"

#: setup.php:679
msgid "Denotes the host to send Exported Graphs to."
msgstr "Biểu thị máy chủ để gửi Đồ thị đã xuất tới."

#: setup.php:686
msgid "Remote Port"
msgstr "Cổng từ xa"

#: setup.php:687
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Cổng giao tiếp được sử dụng cho phương thức xuất nếu không chuẩn (để trống cho mặc định)."

#: setup.php:695
msgid "Use passive mode"
msgstr "Sử dụng chế độ thụ động"

#: setup.php:696
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Kiểm tra điều này nếu bạn muốn kết nối ở chế độ thụ động với máy chủ FTP."

#: setup.php:701
msgid "User"
msgstr "Người dùng"

#: setup.php:702
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Tài khoản để đăng nhập trên máy chủ từ xa (để trống cho mặc định)."

#: setup.php:709
msgid "Password"
msgstr "Mật khẩu"

#: setup.php:710
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Mật khẩu cho tài khoản ftp từ xa (để trống để trống)."

#: setup.php:717
msgid "Private Key Path"
msgstr "Đường dẫn khóa riêng"

#: setup.php:718
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Đối với SCP và RSYNC, nhập đường dẫn Khóa riêng nếu cần."

#: setup.php:741
msgid "Exported Cacti Graph Pages"
msgstr "Trang đồ thị Cacti đã xuất"

#: setup.php:747
msgid "(Edit)"
msgstr "(Sửa)"

#: setup.php:753
msgid "Actions"
msgstr "Hành động"
