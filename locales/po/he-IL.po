msgid "The user name to utilize for establishing permissions to Cacti Graphs.  This user name will be used to determine which Graphs/Trees can be exported.  N/A means don't assume any security is in place."
msgstr "שם המשתמש לנצל עבור הקמת הרשאות ל Cacti גרפים. שם משתמש זה ישמש כדי לקבוע אילו גרפים / עצים ניתן לייצא. N / A אמצעי לא להניח כל אבטחה היא במקום."

#: setup.php:575
msgid "The Tree(s) to export."
msgstr "עץ (ים) כדי לייצא."

#: setup.php:582
msgid "Expand Devices/Sites"
msgstr "הרחב התקנים / אתרים"

#: setup.php:583
msgid "This setting determines if Tree Devices and Site Templates and Devices will be expanded or not.  If set to expanded, each host will have a sub-folder containing either Graph Templates or Data Query items."
msgstr "הגדרה זו קובעת אם התכונה 'מכשירים' ו'תבניות אתרים ומכשירים 'מורחבת או לא. אם מוגדר להרחבה, לכל מארח תהיה תיקיית משנה המכילה תבניות גרפים או פריטי שאילתת נתונים."

#: setup.php:588
msgid "Off"
msgstr "כבוי"

#: setup.php:589
msgid "On"
msgstr "ב"

#: setup.php:594
msgid "The Site for Cacti Graphs to be Exported from."
msgstr "האתר עבור קקטוסים גרפיים להיות מיוצא."

#: setup.php:601
msgid "Graph Thumbnail Width"
msgstr "רוחב תמונה ממוזערת של גרף"

#: setup.php:602
msgid "The default width of Thumbnail Graphs in pixels."
msgstr "רוחב ברירת המחדל של גרפים ממוזערים בפיקסלים."

#: setup.php:610
msgid "Graph Thumbnail Height"
msgstr "גובה תמונה ממוזערת"

#: setup.php:611
msgid "The height of Thumbnail Graphs in pixels."
msgstr "גובה התמונות הממוזערות בפיקסלים."

#: setup.php:619
msgid "Default View Thumbnails"
msgstr "תצוגת ברירת מחדל של תמונות ממוזערות"

#: setup.php:620
msgid "Check this if you want the default Graph View to be in Thumbnail mode."
msgstr "סמן את האפשרות אם ברצונך להציג את תצוגת הגרף המוגדרת כברירת מחדל במצב 'תמונה ממוזערת'."

#: setup.php:625
msgid "Default Graph Columns"
msgstr "עמודות גרף ברירת מחדל"

#: setup.php:626
msgid "The number of columns to use by default when displaying Graphs."
msgstr "מספר העמודות לשימוש כברירת מחדל בעת הצגת גרפים."

#: setup.php:634
msgid "Graphs Per Page"
msgstr "גרפים לעמוד"

#: setup.php:635
msgid "Choose the number of Graphs Per Page to display."
msgstr "בחר את מספר הגרפים לעמוד כדי להציג."

#: setup.php:642
msgid "Maximum Graphs to Export"
msgstr "גרפים מקסימליים לייצוא"

#: setup.php:643
msgid "After this number is reached, an error will be generated, but exporting will continue.  Set to 0 for no limit."
msgstr "לאחר שיגיע מספר זה, תיווצר שגיאה, אך הייצוא ימשיך. הגדר עד 0 ללא הגבלה."

#: setup.php:651
msgid "Export Location Information"
msgstr "ייצוא מידע מיקום"

#: setup.php:656
msgid "Export Thumbnails"
msgstr "ייצוא תזמון"

#: setup.php:657
msgid "Check this if you want the export thumbnails mode."
msgstr "סמן את האפשרות אם ברצונך להציג את תצוגת הגרף המוגדרת כברירת מחדל במצב 'תמונה ממוזערת'."

#: setup.php:662
msgid "Clear Directory"
msgstr "ייצוא מדריך"

#: setup.php:663
msgid "Check this Checkbox if you wish this Graph Export to clear the final directory before populating."
msgstr "סמן תיבה זו אם ברצונך ש'הגדרות ייצוא גרפים 'יופעלו."

#: setup.php:668
msgid "Export Directory"
msgstr "ייצוא מדריך"

#: setup.php:669
msgid "This is the directory, either on the local system or on the remote system, that will contain the exported data."
msgstr "זוהי הספרייה, גם במערכת המקומית או במערכת המרוחקת, שתכיל את הנתונים המיוצאים."

#: setup.php:675
msgid "Local Scratch Directory"
msgstr "מקומי Scratch Directory"

#: setup.php:676
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "זוהי הספרייה כי Cacti יהיה לאחסן את הפלט באופן זמני לפני שליחת לאתר מרוחק באמצעות שיטת ההעברה. התוכן של ספריה זו יימחק לאחר העברת הנתונים."

#: setup.php:683
msgid "Remote Options"
msgstr "אפשרויות מרחוק"

#: setup.php:688
msgid "Sanitize remote directory"
msgstr "לנטרל את המדריך מרחוק"

#: setup.php:689
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "סמן את זה אם ברצונך למחוק קבצים קיימים בספריית ה- FTP מרחוק. אפשרות זו נמצאת בשימוש רק בעת שימוש בפונקציות PHP המובנות ב- PHP."

#: setup.php:694
msgid "Remote Host"
msgstr "‫Remote Host"

#: setup.php:695
msgid "Denotes the host to send Exported Graphs to."
msgstr "מסמן את המארח לשליחת גרפים מיוצאים ל."

#: setup.php:702
msgid "Remote Port"
msgstr "יציאה מרחוק"

#: setup.php:703
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "יציאת תקשורת לשימוש בשיטת הייצוא אם אינה סטנדרטית (השאר ריק לברירות מחדל)."

#: setup.php:711
msgid "Use passive mode"
msgstr "השתמש במצב פסיבי"

#: setup.php:712
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "בדוק אם ברצונך להתחבר במצב פסיבי לשרת ה- FTP."

#: setup.php:717
msgid "User"
msgstr "משתמש"

#: setup.php:718
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "חשבון להתחברות לשרת המרוחק (השאר ריק לברירות מחדל)."

#: setup.php:725
msgid "Password"
msgstr "סיסמה"

#: setup.php:726
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "סיסמה עבור חשבון ה- FTP מרחוק (להשאיר ריק ריק)."

#: setup.php:733
msgid "Private Key Path"
msgstr "נתיב מפתח פרטי"

#: setup.php:734
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "עבור SCP ו- RSYNC, הזן את נתיב המפתח הפרטי אם נדרש."

