#: setup.php
msgid "Choose the number of Graphs Per Page to display."
msgstr "Họrọ ọnụọgụ Eserese Gasị Kwa Ihu Akwụkwọ iji gosi."

#: setup.php
msgid "Maximum Graphs to Export"
msgstr "Eserese Gasị Kacha Elu a ga-Ebupụ"

#: setup.php
msgid "After this number is reached, an error will be generated, but exporting will continue.  Set to 0 for no limit."
msgstr "Mgbe erutere ọnụọgụgụ a, a ga-emepụta njehie, mana mbupụ ga-aga n'ihu.  Tọọ ka ọ bụrụ 0 maka enweghị oke."

#: setup.php
msgid "Export Location Information"
msgstr "Bupụ Ozi Ebe"

#: setup.php
msgid "Export Thumbnails"
msgstr "Bupụ Obere Foto"

#: setup.php
msgid "Check this if you want the export thumbnails mode."
msgstr "Kaa akara a ma ọ bụrụ na ịchọrọ ọnọdụ mbupụ obere foto."

#: setup.php
msgid "Clear Directory"
msgstr "Kpochapụ Ndekọ"

#: setup.php
msgid "Check this Checkbox if you wish this Graph Export to clear the final directory before populating."
msgstr "Kaa akara n'igbe nlele a ma ọ bụrụ na ịchọrọ ka Mbupụ Eserese a kpochapụ ndekọ ikpeazụ tupu o tinye ihe."

#: setup.php
msgid "Export Directory"
msgstr "Ndekọ Mbupụ"

#: setup.php
msgid "This is the directory, either on the local system or on the remote system, that will contain the exported data."
msgstr "Nke a bụ ndekọ, ma na sistemụ mpaghara ma ọ bụ na sistemụ dị anya, nke ga-enwe data ebupụtara."

#: setup.php
msgid "Local Scratch Directory"
msgstr "Ndekọ Nchekwa Nwa Oge Mpaghara"

#: setup.php
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "Nke a bụ ndekọ ebe Cacti ga-echekwa mmepụta nwa oge tupu ezipu ya na saịtị dị anya site n'ụzọ mbufe. A ga-ehichapụ ihe dị na ndekọ a mgbe ebufechara data ahụ."

#: setup.php
msgid "Remote Options"
msgstr "Nhọrọ Dị N'ebe Dị Anya"

#: setup.php
msgid "Sanitize remote directory"
msgstr "Mee ka ndekọ dị anya dị ọcha"

#: setup.php
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Kaa akara a ma ọ bụrụ na ịchọrọ ihichapụ faịlụ ọ bụla dị na ndekọ FTP dịpụrụ adịpụ. Nhọrọ a na-arụ ọrụ naanị mgbe a na-eji ọrụ ftp dị n'ime PHP."

#: setup.php
msgid "Remote Host"
msgstr "Onye nnabata Dị N'ebe Dị Anya"

#: setup.php
msgid "Denotes the host to send Exported Graphs to."
msgstr "Na-egosi onye nnabata a ga-ezigara Eserese Gasị Ebupụrụ."

#: setup.php
msgid "Remote Port"
msgstr "Pọtụ Dị N'ebe Dị Anya"

#: setup.php
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Port nkwukọrịta a ga-eji maka ụzọ mbupụ ma ọ bụrụ na ọ bụghị ọkọlọtọ (hapụ oghere maka ndabara)."

#: setup.php
msgid "Use passive mode"
msgstr "Jiri ọnọdụ passive"

#: setup.php
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Kaa akara a ma ọ bụrụ na ịchọrọ ijikọ na sava FTP n'ọnọdụ passive."

#: setup.php
msgid "User"
msgstr "Onye ọrụ"

#: setup.php
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Akaụntụ iji banye na sava dị n'ebe dị anya (hapụ ya ka ọ tọgbọrọ chakoo maka ndabere)."

#: setup.php
msgid "Password"
msgstr "Okwuntụghe"

#: setup.php
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Okwuntụghe maka akaụntụ ftp dị anya (hapụ ya n'efu ma ọ bụrụ na ọ tọgbọ chakoo)."

#: setup.php
msgid "Private Key Path"
msgstr "Ụzọ Igodo Nzuzo"

#: setup.php
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Maka SCP na RSYNC, tinye ụzọ Igodo Nzuzo ma ọ bụrụ na achọrọ ya."

#: setup.php
msgid "Exported Cacti Graph Pages"
msgstr "Peeji Eserese Cacti Ebupụrụ"

#: setup.php
msgid "(Edit)"
msgstr "(Dezie)"

#: setup.php
msgid "Actions"
msgstr "Omume"

