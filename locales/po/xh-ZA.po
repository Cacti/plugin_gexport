#: setup.php
msgid "Export Thumbnails"
msgstr "Thumela ngaphandle izithonjana"

#: setup.php
msgid "Check this if you want the export thumbnails mode."
msgstr "Phawula oku ukuba ufuna imo yokuthumela ngaphandle imifanekiso emincinci."

#: setup.php
msgid "Clear Directory"
msgstr "Sula uVimba weeFayili"

#: setup.php
msgid "Check this Checkbox if you wish this Graph Export to clear the final directory before populating."
msgstr "Phawula le bhokisi ukuba ufuna oku kuThumela ngaphandle kweGrafu kucime uvimba weefayili wokugqibela phambi kokuba kugalelwe."

#: setup.php
msgid "Export Directory"
msgstr "Idayirekthri yokuThumela ngaphandle"

#: setup.php
msgid "This is the directory, either on the local system or on the remote system, that will contain the exported data."
msgstr "Lo ngumkhombandlela, nokuba ukwindlela yasekuhlaleni okanye kwindlela ekude, oza kuba nedatha ethunyelwe ngaphandle."

#: setup.php
msgid "Local Scratch Directory"
msgstr "Uvimba wethutyana wendawo"

#: setup.php
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "Lo ngumkhombandlela iCacti eza kugcinela kuwo okwethutyana isiphumo phambi kokuthumela kwisiza esikude ngendlela yotshintshiselwano. Okuqulathwe kulo mkhombandlela kuza kucinywa emva kokuba idatha ithunyelwe."

#: setup.php
msgid "Remote Options"
msgstr "Iinketho eziKude"

#: setup.php
msgid "Sanitize remote directory"
msgstr "Coca uvimba weefayili okude"

#: setup.php
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Phawula oku ukuba ufuna ukucima naziphi na iifayile ezikhoyo kuvimba weefayili okude we-FTP. Le ndlela isetyenziswa kuphela xa kusetyenziswa imisebenzi ye-ftp eyakhelwe ngaphakathi kwi-PHP."

#: setup.php
msgid "Remote Host"
msgstr "Ihosti eKude"

#: setup.php
msgid "Denotes the host to send Exported Graphs to."
msgstr "Ibonisa ihosti ekufuneka kuthunyelwe kuyo Iigrafu ezithunyelwe ngaphandle."

#: setup.php
msgid "Remote Port"
msgstr "Iphothi eKude"

#: setup.php
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "I-port yonxibelelwano emayisetyenziswe kwindlela yokuthumela ngaphandle ukuba ayisiyo eqhelekileyo (shiya kungenanto kwiisetingi ezisisiseko)."

#: setup.php
msgid "Use passive mode"
msgstr "Sebenzisa imo ye-passive"

#: setup.php
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Phawula oku ukuba ufuna ukuqhagamshela kwimo engenzi nto (passive mode) kwiseva ye-FTP."

#: setup.php
msgid "User"
msgstr "Umsebenzisi"

#: setup.php
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "I-akhawunti yokungena kwiserver ekude (shiya ingenanto ukuze kusetyenziswe okungagqibekanga)."

#: setup.php
msgid "Password"
msgstr "Iphasiwedi"

#: setup.php
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Iphasiwedi ye-akhawunti ekude ye-ftp (shiya kungenanto ukuze kube yindawo engenanto)."

#: setup.php
msgid "Private Key Path"
msgstr "Umendo wesitshixo sabucala"

#: setup.php
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Kwi-SCP ne-RSYNC, faka indlela ye-Private Key ukuba iyafuneka."

#: setup.php
msgid "Exported Cacti Graph Pages"
msgstr "Amaphepha eGrafu ye-Cacti athunyelwe ngaphandle"

#: setup.php
msgid "(Edit)"
msgstr "(Hlela)"

#: setup.php
msgid "Actions"
msgstr "Izenzo"

