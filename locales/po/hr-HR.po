msgstr "Lokalni privremeni direktorij"

#: setup.php
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "Ovo je direktorij u koji će Cacti privremeno pohranjivati izlaz prije slanja na udaljeno mjesto putem načina prijenosa. Sadržaj ovog direktorija izbrisat će se nakon prijenosa podataka."

#: setup.php
msgid "Remote Options"
msgstr "Udaljene mogućnosti"

#: setup.php
msgid "Sanitize remote directory"
msgstr "Očisti udaljeni direktorij"

#: setup.php
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Označite ovo ako želite izbrisati sve postojeće datoteke u udaljenom FTP direktoriju. Ova se mogućnost koristi samo kada se upotrebljavaju ugrađene PHP FTP funkcije."

#: setup.php
msgid "Remote Host"
msgstr "Udaljeni poslužitelj"

#: setup.php
msgid "Denotes the host to send Exported Graphs to."
msgstr "Označava poslužitelj na koji se šalju izvezeni grafikoni."

#: setup.php
msgid "Remote Port"
msgstr "Udaljeni port"

#: setup.php
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Komunikacijski port koji se koristi za način izvoza ako nije standardni (ostavite prazno za zadane vrijednosti)."

#: setup.php
msgid "Use passive mode"
msgstr "Koristi pasivni način"

#: setup.php
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Označite ovo ako se želite povezati s FTP poslužiteljem u pasivnom načinu."

#: setup.php
msgid "User"
msgstr "Korisnik"

#: setup.php
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Račun za prijavu na udaljeni poslužitelj (ostavite prazno za zadane vrijednosti)."

#: setup.php
msgid "Password"
msgstr "Lozinka"

#: setup.php
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Lozinka za udaljeni FTP račun (ostavite prazno za praznu lozinku)."

#: setup.php
msgid "Private Key Path"
msgstr "Putanja privatnog ključa"

#: setup.php
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Za SCP i RSYNC unesite putanju privatnog ključa ako je potrebno."

#: setup.php
msgid "Exported Cacti Graph Pages"
msgstr "Izvezene stranice Cacti grafikona"

#: setup.php
msgid "(Edit)"
msgstr "(Uredi)"

#: setup.php
msgid "Actions"
msgstr "Radnje"
