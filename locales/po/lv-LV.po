#: setup.php
msgid "After this number is reached, an error will be generated, but exporting will continue.  Set to 0 for no limit."
msgstr "Pārsniedzot šo skaitli, tiks ģenerēta kļūda, taču eksportēšana turpināsies.  Iestatiet uz 0, ja vēlaties bez ierobežojumiem."

#: setup.php
msgid "Export Location Information"
msgstr "Eksportēt atrašanās vietas informāciju"

#: setup.php
msgid "Export Thumbnails"
msgstr "Eksportēt sīktēlus"

#: setup.php
msgid "Check this if you want the export thumbnails mode."
msgstr "Atķeksējiet, ja vēlaties eksportēt sīktēlus."

#: setup.php
msgid "Clear Directory"
msgstr "Tīrīt mapi"

#: setup.php
msgid "Check this Checkbox if you wish this Graph Export to clear the final directory before populating."
msgstr "Atķeksējiet, ja vēlaties, lai šī grafika eksportēšana dzēstu saturu pēdējā izvēlētajā mapē pirms aizpildīšanas."

#: setup.php
msgid "Export Directory"
msgstr "Izgūšanas mape"

#: setup.php
msgid "This is the directory, either on the local system or on the remote system, that will contain the exported data."
msgstr "Lokālas sistēmas vai attālajā sistēmas mape, kurā tiks eksportēti dati."

#: setup.php
msgid "Local Scratch Directory"
msgstr "Lokālā pagaidu mape"

#: setup.php
msgid "This is the directory that Cacti will temporarily store output prior to sending to the remote site via the transfer method.  The contents of this directory will be deleted after the data is transferred."
msgstr "Mape, kurā Cacti īslaicīgi saglabās izvadi pirms nosūtīšanas uz attālo vietni, izmantojot izvēlēto pārsūtīšanas veidu.  Pēc datu pārsūtīšanas šīs mapes saturs tiks dzēsts."

#: setup.php
msgid "Remote Options"
msgstr "Attālās iespējas"

#: setup.php
msgid "Sanitize remote directory"
msgstr "Sagatavot attālo mapi"

#: setup.php
msgid "Check this if you want to delete any existing files in the FTP remote directory. This option is in use only when using the PHP built-in ftp functions."
msgstr "Atķeksējiet, ja vēlaties dzēst visus esošos failus FTP attālajā mapē. Šī iespēja tiek izmantota tikai tad, ja tiek izmantotas PHP iebūvētās ftp funkcijas."

#: setup.php
msgid "Remote Host"
msgstr "Attālais resursdators"

#: setup.php
msgid "Denotes the host to send Exported Graphs to."
msgstr "Nozīmē resursdators, kuram nosūtīt eksportētos grafikus."

#: setup.php
msgid "Remote Port"
msgstr "Attālais ports"

#: setup.php
msgid "Communication port to use for the export method if non-standard (leave empty for defaults)."
msgstr "Sakaru ports, ko izmantot eksportēšanas veidam, ja tas nav standarta (atstājiet tukšu noklusējuma iestatījumiem)."

#: setup.php
msgid "Use passive mode"
msgstr "Lietot pasīvo režīmu"

#: setup.php
msgid "Check this if you want to connect in passive mode to the FTP server."
msgstr "Atķeksējiet, ja vēlaties veidot FTP savienojumu ar serveri pasīvā režīmā."

#: setup.php
msgid "User"
msgstr "Lietotājs"

#: setup.php
msgid "Account to logon on the remote server (leave empty for defaults)."
msgstr "Konts, lai pieteiktos attālajā serverī (atstājiet tukšu, ja vēlaties izmantot noklusējuma iestatījumus)."

#: setup.php
msgid "Password"
msgstr "Parole"

#: setup.php
msgid "Password for the remote ftp account (leave empty for blank)."
msgstr "Attālā FTP konta parole (atstājiet tukšu, ja bez paroles)."

#: setup.php
msgid "Private Key Path"
msgstr "Privātā atslēgas ceļš"

#: setup.php
msgid "For SCP and RSYNC, enter the Private Key path if required."
msgstr "Izmantojot SCP vai RSYNC, ja nepieciešams ievadiet privātās atslēgas ceļu."

#: setup.php
msgid "Exported Cacti Graph Pages"
msgstr "Eksportētas Cacti grafika lapas"

#: setup.php
msgid "(Edit)"
msgstr "(Rediģēt)"

#: setup.php
msgid "Actions"
msgstr "Darbības"
